{
  "name": "@spherepath/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false next dev -p 5050",
    "dev:emulators": "NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true next dev -p 5050",
    "lint": "eslint .",
    "start": "next start -p 5050",
    "test": "vitest run --passWithNoTests --exclude 'e2e/**'",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@spherepath/shared": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "firebase": "12.18.0",
    "lucide-react": "1.35.0",
    "next": "16.3.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
