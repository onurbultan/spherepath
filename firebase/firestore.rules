rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function officeId() {
      return request.auth.token.officeId;
    }

    function isBroker() {
      return signedIn() && request.auth.token.role == 'broker';
    }

    function bounded(maximum) {
      return request.query.limit != null && request.query.limit <= maximum;
    }

    function sameOffice() {
      return signedIn() && resource.data.officeId == officeId();
    }

    function incomingSameOffice() {
      return signedIn() && request.resource.data.officeId == officeId();
    }

    function ownsResource() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function ownsIncoming() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function canReadPrivate() {
      return sameOffice() && (ownsResource() || isBroker());
    }

    function immutableTenant() {
      return request.resource.data.officeId == resource.data.officeId
        && request.resource.data.ownerUid == resource.data.ownerUid;
    }

    function contactBelongsToCaller(contactId) {
      let contact = get(/databases/$(database)/documents/contacts/$(contactId)).data;
      return contact.officeId == officeId()
        && (contact.ownerUid == request.auth.uid || isBroker());
    }

    function validContactDocument() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'officeId', 'ownerUid', 'phone', 'phoneHash', 'fullName', 'label',
          'metAtPlace', 'metAt', 'source', 'roles', 'relationship', 'privacy',
          'deletedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'officeId', 'ownerUid', 'phone', 'phoneHash', 'fullName', 'label',
          'metAtPlace', 'metAt', 'source', 'roles', 'relationship', 'privacy',
          'deletedAt', 'createdAt', 'updatedAt'
        ])
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 120
        && (data.phone == null || data.phone is string)
        && (data.phone == null || data.phone.size() <= 30)
        && data.phoneHash == null
        && data.label == null
        && (data.metAtPlace == null || data.metAtPlace is string)
        && (data.metAtPlace == null || data.metAtPlace.size() <= 160)
        && data.metAt is timestamp
        && data.source in ['in_person', 'referral', 'listing', 'social', 'door', 'area', 'address_book', 'other']
        && data.roles is list
        && data.roles.size() >= 1
        && data.roles.size() <= 9
        && data.roles.toSet().hasOnly([
          'buyer', 'seller', 'tenant', 'landlord', 'investor', 'peer',
          'information_source', 'referral_source', 'unknown'
        ])
        && data.relationship is map
        && data.relationship.keys().hasAll([
          'stage', 'meaningfulTouchCount', 'reciprocalTouchCount', 'lastTouchAt',
          'nextActionAt', 'nextActionType', 'lastObjective', 'lastAskOutcome', 'referralCount'
        ])
        && data.relationship.keys().hasOnly([
          'stage', 'meaningfulTouchCount', 'reciprocalTouchCount', 'lastTouchAt',
          'nextActionAt', 'nextActionType', 'lastObjective', 'lastAskOutcome', 'referralCount'
        ])
        && data.relationship.stage in ['new', 'getting_to_know', 'engaged', 'active', 'referral_source']
        && data.relationship.meaningfulTouchCount is int
        && data.relationship.reciprocalTouchCount is int
        && data.relationship.referralCount is int
        && (data.relationship.lastTouchAt == null || data.relationship.lastTouchAt is timestamp)
        && (data.relationship.nextActionAt == null || data.relationship.nextActionAt is timestamp)
        && (data.relationship.nextActionType == null || data.relationship.nextActionType in [
          'call', 'message', 'appointment', 'valuation', 'offer',
          'complete_permission', 'make_ask', 'other'
        ])
        && (data.relationship.lastObjective == null || data.relationship.lastObjective in [
          'get_acquainted', 'provide_value', 'permission', 'appointment',
          'request_referral', 'request_listing', 'follow_up', 'presentation', 'offer'
        ])
        && (data.relationship.lastAskOutcome == null || data.relationship.lastAskOutcome in [
          'positive', 'unclear', 'negative', 'not_asked', 'not_applicable'
        ])
        && data.privacy is map
        && data.privacy.keys().hasAll([
          'noticeStatus', 'noticeAt', 'noticeMethod', 'noticeVersion', 'marketingConsent',
          'marketingChannels', 'profilingObjection', 'deletionRequestedAt'
        ])
        && data.privacy.keys().hasOnly([
          'noticeStatus', 'noticeAt', 'noticeMethod', 'noticeVersion', 'marketingConsent',
          'marketingChannels', 'profilingObjection', 'deletionRequestedAt'
        ])
        && data.privacy.noticeStatus in ['pending', 'completed']
        && (data.privacy.noticeAt == null || data.privacy.noticeAt is timestamp)
        && (data.privacy.noticeMethod == null || data.privacy.noticeMethod in ['verbal', 'written', 'electronic'])
        && (data.privacy.noticeVersion == null || data.privacy.noticeVersion is string)
        && data.privacy.marketingConsent in ['unknown', 'granted', 'withdrawn']
        && data.privacy.marketingChannels is list
        && data.privacy.marketingChannels.toSet().hasOnly(['phone', 'whatsapp', 'sms', 'email'])
        && data.privacy.profilingObjection is bool
        && (data.privacy.deletionRequestedAt == null || data.privacy.deletionRequestedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.deletedAt == null || data.deletedAt is timestamp);
    }

    match /offices/{documentId} {
      allow get: if signedIn() && documentId == officeId();
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || (isBroker() && sameOffice()));
      allow list: if isBroker() && sameOffice() && bounded(100);
      allow create, delete: if false;
      allow update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.officeId == resource.data.officeId
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phone', 'defaultRegions', 'monthlyPortfolioTarget',
          'weeklyCapacity', 'updatedAt'
        ]);
    }

    match /contacts/{contactId} {
      allow get: if canReadPrivate();
      allow list: if canReadPrivate() && bounded(200);
      allow create: if incomingSameOffice()
        && ownsIncoming()
        && request.resource.data.deletedAt == null
        && validContactDocument();
      allow update: if canReadPrivate()
        && immutableTenant()
        && validContactDocument()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'phone', 'phoneHash', 'fullName', 'label', 'metAtPlace',
          'metAt', 'source', 'roles', 'relationship', 'updatedAt', 'deletedAt'
        ])
        && request.resource.data.relationship.diff(resource.data.relationship).affectedKeys().hasOnly([
          'nextActionAt', 'nextActionType'
        ]);
      allow delete: if false;
    }

    match /interactions/{interactionId} {
      allow get: if canReadPrivate();
      allow list: if canReadPrivate() && bounded(200);
      allow create: if incomingSameOffice()
        && ownsIncoming()
        && request.resource.data.contactId is string
        && contactBelongsToCaller(request.resource.data.contactId)
        && request.resource.data.occurredAt is timestamp
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /opportunities/{opportunityId} {
      allow get: if canReadPrivate();
      allow list: if canReadPrivate() && bounded(200);
      allow create: if incomingSameOffice()
        && ownsIncoming()
        && contactBelongsToCaller(request.resource.data.subjectContactId)
        && request.resource.data.stage == 'new_lead';
      allow update: if canReadPrivate()
        && immutableTenant()
        && request.resource.data.stage == resource.data.stage
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nextActionAt', 'estimatedValue', 'updatedAt', 'deletedAt'
        ]);
      allow delete: if false;
    }

    match /dailyTasks/{taskId} {
      allow get: if canReadPrivate();
      allow list: if canReadPrivate() && bounded(100);
      allow create, delete: if false;
      allow update: if canReadPrivate()
        && immutableTenant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'completedAt', 'skippedReason', 'updatedAt'
        ]);
    }

    match /stageEvents/{eventId} {
      allow get: if canReadPrivate();
      allow list: if canReadPrivate() && bounded(500);
      allow create, update, delete: if false;
    }

    match /voiceNotes/{noteId} {
      allow get: if canReadPrivate();
      allow list: if canReadPrivate() && bounded(50);
      allow create: if incomingSameOffice()
        && ownsIncoming()
        && request.resource.data.status == 'uploaded'
        && request.resource.data.createdAt is timestamp;
      allow update: if canReadPrivate()
        && immutableTenant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'contactId', 'interactionId', 'corrections'
        ]);
      allow delete: if ownsResource() && sameOffice();
    }

    match /commands/{commandId} {
      allow get: if canReadPrivate();
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
